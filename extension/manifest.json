{
  "manifest_version": 3,
  "name": "My Browser",
  "version": "1.0.0",
  "description": "Lets the Claude PC app read and use websites in this Chrome. Works only with the My Browser program on this PC.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "My Browser"
  }
}
